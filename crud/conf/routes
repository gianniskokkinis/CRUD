# An example controller showing a sample home page
GET     /                           controllers.HomeController.index()

# Map static resources from the /public folder to the /assets URL path
GET     /assets/*file               controllers.Assets.versioned(path="/public", file: Asset)

#ProductController POST - JSON , PUT - JSON
POST    /products/create   controllers.ProductController.createProduct(request: Request)
POST    /products/get   controllers.ProductController.getAllProducts()
POST    /products/update   controllers.ProductController.updateProduct(request: Request)
POST    /products/delete   controllers.ProductController.deleteProduct(request: Request)

