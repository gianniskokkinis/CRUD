# Routes
# This file defines all application routes (Higher priority routes first)
# ~~~~

# An example controller showing a sample home page
GET     /                           controllers.HomeController.index()

# Map static resources from the /public folder to the /assets URL path
GET     /assets/*file               controllers.Assets.versioned(path="/public", file: Asset)

#ProductController POST - JSON , PUT - JSON
POST    /products   controllers.ProductController.createProduct(request: Request)
GET     /products   controllers.ProductController.getAllProducts(request: Request)
PUT     /products   controllers.ProductController.updateProduct(request: Request)
DELETE  /products/:id   controllers.ProductController.deleteProduct(id: Integer)

